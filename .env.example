# Copy this file to .env and adjust as needed.
# .env is git-ignored; .env.example is the checked-in template. Never commit
# real credentials -- everything below is a local-dev default, safe to see
# in a public repo because it only ever points at containers on localhost.

# --- Postgres (this repo's own OLTP-mirror instance -- see ADR-009) ---
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://analytics:analytics@localhost:5433/analytics

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=labadmin
MINIO_ROOT_PASSWORD=labpassword
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=labadmin
MINIO_SECRET_KEY=labpassword
MINIO_BUCKET=analytics-lake

# --- Ingestion ---
# Logging level for the ingestion package (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
